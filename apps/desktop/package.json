{
  "name": "contextcake-desktop",
  "productName": "ContextCake",
  "private": true,
  "version": "0.7.3",
  "description": "ContextCake for Mac — desktop shell over the engine and console",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "renderer": "npm --prefix ../console run build:live",
    "start": "electron .",
    "dev": "npm run renderer && electron .",
    "test": "node --test test/*.test.mjs",
    "icon": "electron scripts/generate-icon.mjs",
    "test:navigation": "node scripts/navigation-test.mjs",
    "test:cli-status": "node scripts/cli-status-test.mjs",
    "smoke": "CC_SMOKE=1 electron .",
    "smoke:settings": "CC_SMOKE=1 CC_SMOKE_SETTINGS=1 electron .",
    "smoke:ui": "CC_SMOKE=1 CC_SMOKE_UI=1 electron .",
    "smoke:ui:artifacts": "node scripts/ui-artifacts.mjs",
    "smoke:bootfail": "node scripts/smoke-bootfail.mjs",
    "smoke:relaunch": "CC_SMOKE=1 CC_SMOKE_RELAUNCH=1 electron .",
    "test:isolation": "node scripts/engine-isolation-test.mjs",
    "supabase:config": "node scripts/generate-supabase-config.mjs",
    "prepack": "npm run supabase:config",
    "pack": "npm run renderer && electron-builder --mac --arm64 --dir",
    "predist": "npm run supabase:config",
    "dist": "npm run renderer && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
