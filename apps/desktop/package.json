{
  "name": "contextcake-desktop",
  "productName": "ContextCake",
  "private": true,
  "version": "0.10.2",
  "description": "ContextCake desktop app: the engine and console in one window",
  "homepage": "https://contextcake.com",
  "desktopName": "contextcake-desktop.desktop",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "renderer": "npm --prefix ../console run build:live",
    "start": "electron .",
    "dev": "npm run renderer && electron .",
    "pretest": "node -e \"require('electron')\"",
    "test": "node --test test/*.test.mjs",
    "icon": "electron scripts/generate-icon.mjs",
    "test:navigation": "node scripts/navigation-test.mjs",
    "test:cli-status": "node scripts/cli-status-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:settings": "node scripts/smoke.mjs settings",
    "smoke:ui": "node scripts/smoke.mjs ui",
    "smoke:ui:artifacts": "node scripts/ui-artifacts.mjs",
    "smoke:bootfail": "node scripts/smoke-bootfail.mjs",
    "smoke:crash": "node scripts/engine-crash-test.mjs",
    "smoke:relaunch": "node scripts/smoke.mjs relaunch",
    "test:isolation": "node scripts/engine-isolation-test.mjs",
    "supabase:config": "node scripts/generate-supabase-config.mjs",
    "prepack": "npm run supabase:config",
    "pack": "npm run renderer && electron-builder --mac --dir",
    "predist": "npm run supabase:config",
    "dist": "npm run renderer && electron-builder --mac",
    "predist:linux": "npm run supabase:config",
    "dist:linux": "npm run renderer && node scripts/dist-linux.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "11.0.1"
    }
  }
}
