---
// A readable excerpt of actual resolver output, not a simulated app or AI reply.
import demo from '../data/demo-cascade.json';
const concept = demo.concepts.find((item) => item.id === 'decisions/primary-db');
if (!concept) throw new Error('Homepage requires demo concept decisions/primary-db');
const sections = ['choice', 'rationale', 'ownership'].map((key) => {
  const section = concept.sections.find((item) => item.key === key && !item.suppressed);
  if (!section?.content.trim()) throw new Error(`Homepage demo section ${key} is missing`);
  return section;
});
const labels = { choice: 'Application database', rationale: 'Why analytics is separate', ownership: 'Who owns it' };
const names = { personal: 'Personal', team: 'Team', company: 'Company' };
const reasons = {
  choice: 'Highest-priority version',
  rationale: 'Inherited from Team',
  ownership: 'Inherited from Company',
};
const sentenceCount = { choice: 1, rationale: 1, ownership: 1 };
const excerpt = (text: string, count = 1) => {
  const normalized = text.replace(/\s+/g, ' ').trim();
  return normalized.match(/[^.!?]+[.!?]+|[^.!?]+$/g)?.slice(0, count).join(' ').trim() ?? normalized;
};
const priorities = [...concept.contributors].sort((a, b) => b.level - a.level);
---
<figure class="context-preview">
  <div class="preview-top"><span class="preview-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>ContextCake</span><span class="example-label">Worked example</span></div>
  <div class="preview-heading"><span>Question</span><h2>What database setup should this service use?</h2><code>{concept.id}</code></div>
  <div class="priority">
    <div class="priority-heading"><strong>This example uses source priority</strong><span>Highest first · section by section</span></div>
    <ol>
      {priorities.map((source, index) => (
        <li style={`--source-color: var(--cc-layer-${source.layer})`}><span>{index + 1}</span><i aria-hidden="true"></i>{names[source.layer]}</li>
      ))}
    </ol>
  </div>
  <div class="preview-answer">
    <strong class="answer-label">Combined answer</strong>
    <div class="preview-sections">
      {sections.map((section) => (
        <section class="context-section" style={`--source-color: var(--cc-layer-${section.sourceLayer})`}>
          <div class="section-meta"><h3>{labels[section.key]}</h3><span class="source-badge"><i aria-hidden="true"></i>{names[section.sourceLayer]}</span></div>
          <p>{excerpt(section.content, sentenceCount[section.key])}</p>
          <div class="section-reason"><span>{reasons[section.key]}</span>{section.sourceUpdated && <time datetime={section.sourceUpdated}>{section.sourceUpdated}</time>}</div>
          {section.key === 'rationale' && section.conflicts?.[0] && <aside class="context-conflict"><div><strong>{names[section.conflicts[0].layer]} has a different version</strong><span>Disagreement kept with this section</span></div><p>{excerpt(section.conflicts[0].content)}</p></aside>}
        </section>
      ))}
    </div>
  </div>
  <figcaption>Actual resolver output from the bundled demo. Here, higher-priority sources win only the sections they define; the rest falls through.</figcaption>
</figure>
<style>
	.context-preview {
		margin: 0;
		border: 1px solid var(--cc-border-strong);
		border-radius: 12px;
		background: var(--cc-surface-solid);
		color: var(--cc-text-body);
		overflow: clip;
	}
	.preview-top {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 22px;
		border-bottom: 1px solid var(--cc-border);
		font-size: 13px;
		font-weight: 600;
		color: var(--cc-text);
	}
	.preview-mark {
		display: grid;
		gap: 2px;
		width: 19px;
		justify-items: center;
	}
	.preview-mark i {
		height: 3px;
		width: 19px;
		background: var(--cc-layer-company);
		border-radius: 2px;
	}
	.preview-mark i:first-child {
		width: 11px;
		background: var(--cc-layer-personal);
	}
	.preview-mark i:nth-child(2) {
		width: 15px;
		background: var(--cc-layer-team);
	}
	.example-label {
		margin-left: auto;
		color: var(--cc-text-muted);
		font-size: 12px;
		font-weight: 400;
	}
	.preview-heading {
		padding: 20px 24px 16px;
	}
	.preview-heading > span {
		display: block;
		margin-bottom: 5px;
		font-size: 11px;
		font-weight: 600;
		color: var(--cc-text-muted);
	}
	.preview-heading h2 {
		margin: 0 0 5px;
		font-size: 22px;
		letter-spacing: -.02em;
		font-weight: 600;
		line-height: 1.25;
	}
	code {
		font: 11px/1.5 var(--cc-font-mono);
		color: var(--cc-text-muted);
	}
	.priority {
		padding: 13px 24px 15px;
		border-block: 1px solid var(--cc-border);
		background: var(--cc-surface-soft);
	}
	.priority-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px 16px;
		margin-bottom: 10px;
		font-size: 11px;
	}
	.priority-heading strong {
		color: var(--cc-text);
		font-weight: 600;
	}
	.priority-heading span {
		color: var(--cc-text-muted);
	}
	.priority ol {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 7px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.priority li {
		display: flex;
		align-items: center;
		gap: 7px;
		min-width: 0;
		padding: 7px 9px;
		border: 1px solid var(--cc-border);
		border-radius: 6px;
		background: var(--cc-surface-solid);
		color: var(--cc-text-body);
		font-size: 11px;
		font-weight: 600;
	}
	.priority li > span {
		color: var(--cc-text-muted);
		font: 10px/1 var(--cc-font-mono);
	}
	.priority li > i,
	.source-badge i {
		width: 7px;
		height: 7px;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--source-color);
	}
	.preview-answer {
		padding-top: 15px;
	}
	.answer-label {
		display: block;
		padding: 0 24px;
		color: var(--cc-text);
		font-size: 12px;
	}
	.preview-sections {
		padding: 0 24px;
	}
	.context-section {
		padding: 14px 0;
		border-bottom: 1px solid var(--cc-border);
	}
	.context-section:last-child { border-bottom: 0; }
	.section-meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 3px 8px;
	}
	h3 {
		margin: 0;
		font-size: 13px;
		font-weight: 600;
	}
	.source-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		font-weight: 600;
		color: var(--cc-text-body);
	}
	.context-section p {
		margin: 5px 0 0;
		font-size: 14px;
		line-height: 1.55;
		text-wrap: pretty;
	}
	.section-reason {
		display: flex;
		justify-content: space-between;
		gap: 8px 16px;
		margin-top: 6px;
		color: var(--cc-text-muted);
		font-size: 10px;
	}
	.section-reason time {
		font-family: var(--cc-font-mono);
	}
	.context-conflict {
		margin-top: 11px;
		padding: 10px 12px;
		border: 1px solid color-mix(in srgb, var(--cc-conflict) 45%, var(--cc-border));
		border-radius: 6px;
		background: color-mix(in srgb, var(--cc-conflict) 7%, var(--cc-surface-solid));
	}
	.context-conflict > div {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 3px 10px;
		font-size: 11px;
		color: var(--cc-text);
	}
	.context-conflict > div > span {
		color: var(--cc-text-muted);
	}
	.context-conflict p {
		font-size: 12px;
		line-height: 1.5;
		margin: 5px 0 0;
	}
	figcaption {
		padding: 12px 24px;
		border-top: 1px solid var(--cc-border);
		color: var(--cc-text-muted);
		font-size: 11px;
		line-height: 1.6;
	}
	@media (max-width: 480px) {
		.preview-top {
			padding-inline: 17px;
		}
		.preview-heading {
			padding-inline: 18px;
		}
		.preview-heading h2 {
			font-size: 21px;
		}
		.priority {
			padding-inline: 18px;
		}
		.priority-heading {
			display: block;
		}
		.priority-heading span {
			display: block;
			margin-top: 2px;
		}
		.priority ol {
			grid-template-columns: 1fr;
		}
		.answer-label {
			padding-inline: 18px;
		}
		.preview-sections {
			padding-inline: 18px;
		}
		figcaption {
			padding-inline: 18px;
		}
	}
</style>
