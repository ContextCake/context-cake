---
// Install page: the Mac app is the primary activation path. The versioned
// source workflow stays available for evaluators, Linux/WSL users, and audits.
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import demo from '../data/demo-cascade.json';
import {
	appVersion,
	appTag,
	appDownloadUrl,
	appDownloadName,
	appDownloadBytes,
	appReleaseUrl,
	appChecksumsUrl,
	appDownloadSha256,
	appMcpb,
} from '../data/app-release';
import {
	sourceTag,
	sourceDownloadUrl,
	sourceArchiveSha256,
} from '../data/source-release';

const archiveName = `context-cake-${sourceTag}.tar.gz`;
const sourceTagUrl = `https://github.com/ContextCake/context-cake/tree/${sourceTag}`;

const terminalDownload = `curl --fail --location ${sourceDownloadUrl} \\
  --output ${archiveName}`;
const githubCliCheckout = `gh repo clone ContextCake/context-cake contextcake -- \\
  --branch ${sourceTag} --depth 1
cd contextcake`;
const gitCheckout = `git clone --branch ${sourceTag} --depth 1 \\
  https://github.com/ContextCake/context-cake.git contextcake
cd contextcake`;
const unpackCommand = `printf '%s  %s\\n' '${sourceArchiveSha256}' '${archiveName}' | shasum -a 256 --check &&
mkdir contextcake &&
tar -xzf ${archiveName} -C contextcake --strip-components=1 &&
cd contextcake`;
const resolveCommand = 'node resolver.mjs --manifest playground/manifest.json --concept decisions/primary-db';
const testPrompt = 'Use ContextCake to list the available concepts. Name the sources each one uses and the project questions it can help answer.';

const demoConceptId = 'decisions/primary-db';
const primaryDb = demo.concepts.find((concept) => concept.id === demoConceptId);
if (!primaryDb) throw new Error(`Install demo concept ${demoConceptId} is missing`);

const resolvedChoice = primaryDb.sections.find(
	(section) => section.key === 'choice' && !section.suppressed,
);
if (!resolvedChoice) throw new Error('Install demo choice section is missing');

const conflict = resolvedChoice.conflicts?.[0];
const summarize = (value: string, limit = 108) => {
	const oneLine = value.replace(/\s+/g, ' ').trim();
	return oneLine.length > limit ? `${oneLine.slice(0, limit).trimEnd()}…` : oneLine;
};
const dateFormatter = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});
const formatDate = (iso: string) => dateFormatter.format(new Date(`${iso}T00:00:00Z`));
const formatFileSize = (bytes: number) => `${(bytes / 1_048_576).toFixed(1)} MB`;
---

<Base
	tone="dark"
	title="Install ContextCake"
	description="Download ContextCake for Mac, choose a folder of Markdown files, and connect Codex, Claude, Cursor, or another MCP-compatible AI tool."
>
	<main class="install-page">
		<section class="install-hero" aria-labelledby="install-title">
			<div class="hero-copy">
				<p class="eyebrow">ContextCake for Mac · {appTag}</p>
				<h1 id="install-title">Download ContextCake for Mac.</h1>
				<p class="lede">
					ContextCake runs locally. After you install it, choose a folder of Markdown files
					and connect the AI tool you use. The app walks you through both steps.
				</p>
				<section class="download-module" aria-labelledby="download-title">
					<div class="download-module__top">
						<div>
							<p>Mac app</p>
							<h2 id="download-title">Apple silicon (M1 or later)</h2>
							<span>{appDownloadName} · {formatFileSize(appDownloadBytes)} · signed and notarized</span>
						</div>
						<a class="button button--primary" href={appDownloadUrl} download>
							<Icon name="download" size={18} />
							Download for Mac
						</a>
					</div>
					<div class="download-record" aria-label="Release details">
						<span>{appTag}</span>
						<a href={appReleaseUrl}>Release notes</a>
						<a href={appChecksumsUrl}>SHA-256 checksums</a>
					</div>
				</section>
				<nav class="install-alternatives" aria-label="Other installation options">
					<a href="#source-install"><span>Using an Intel Mac, Linux, or WSL?</span> Run the versioned source <b aria-hidden="true">→</b></a>
					<a href={appReleaseUrl}><span>Looking for an older build?</span> See all app releases <b aria-hidden="true">→</b></a>
				</nav>
				{appMcpb && (
					<section class="mcpb-route" aria-labelledby="mcpb-route-title">
						<div>
							<p>Claude Desktop</p>
							<h2 id="mcpb-route-title">Add ContextCake to Claude Desktop</h2>
							<span>Install the MCP bundle, then choose the ContextCake manifest you want Claude to use. Activation metrics are off by default.</span>
						</div>
						<a class="button button--secondary" href={appMcpb.url} download>
							<Icon name="download" size={17} /> Download .mcpb
						</a>
						<small>{appMcpb.name} · {formatFileSize(appMcpb.bytes)} · <a href={appChecksumsUrl}>SHA-256</a></small>
					</section>
				)}
			</div>

			<figure class="app-preview" aria-labelledby="app-preview-title">
				<div class="window-bar" aria-hidden="true">
					<span></span><span></span><span></span>
					<strong>ContextCake</strong>
				</div>
				<div class="app-shell-preview">
					<div class="preview-sidebar" aria-hidden="true">
						<strong>ContextCake</strong>
							<span class="active">Home</span>
							<span>Sources</span>
							<span>Review</span>
					</div>
					<div class="preview-content">
						<p>First source</p>
						<h2 id="app-preview-title">Choose a folder with Markdown files</h2>
						<div class="folder-choice">
							<Icon name="layers" size={18} />
							<div><strong>Markdown folder</strong><span>Recommended · no conversion required</span></div>
							<span class="selected-mark">✓</span>
						</div>
						<div class="preview-success">
							<span></span>
							<div><strong>Folder added</strong><small>ContextCake can now read these files.</small></div>
						</div>
						<div class="preview-action"><span>Connect an AI tool</span><span>→</span></div>
					</div>
				</div>
				<figcaption>Choose your files first. The app gives you the connection steps next.</figcaption>
			</figure>
		</section>

		<section class="activation" aria-labelledby="activation-title">
			<header class="section-intro">
				<h2 id="activation-title">Set up the app in three steps.</h2>
				<p>You do not need to write a manifest or run a terminal command for the standard Mac setup.</p>
			</header>

			<ol class="activation-steps">
				<li>
					<span class="step-number">1</span>
					<div class="step-copy">
						<h3>Choose a folder with Markdown files</h3>
						<p>
								A repository docs folder, Obsidian vault, or Markdown wiki export works without conversion.
							You can add more folders and repositories later.
						</p>
					</div>
					<div class="step-proof source-proof" aria-label="Example source selection">
						<span>Markdown folder · recommended</span>
						<strong>~/Documents/Work notes</strong>
						<small>.md · .mdx · .txt</small>
					</div>
				</li>

				<li>
					<span class="step-number">2</span>
					<div class="step-copy">
						<h3>Connect your AI tool</h3>
						<p>
							Choose <strong>Connect an agent</strong> in the app. MCP is the local connection
							that lets compatible AI tools search and read your ContextCake sources.
						</p>
					</div>
					<div class="step-proof client-proof" aria-label="Supported AI clients">
						<span>Claude Code</span>
						<span>Codex</span>
						<span>Cursor</span>
						<span>Claude Desktop</span>
						<span>Other MCP</span>
					</div>
				</li>

				<li>
					<span class="step-number">3</span>
					<div class="step-copy">
							<h3>Run the test prompt</h3>
							<p>
								Try this prompt to check the connection. The answer should name
								the source it used and show any conflicting version.
							</p>
							<CodeBlock lang="text" code={testPrompt} label="Test prompt" copy />
					</div>
					<figure class="result-preview" aria-labelledby="result-title">
						<div class="result-header">
							<div><span>Sourced answer</span><h3 id="result-title">{demoConceptId}</h3></div>
							<span class="result-status"><i></i> resolved</span>
						</div>
						<div class="result-row" style="--result-color: var(--cc-layer-personal)">
							<span class="result-swatch" aria-hidden="true"></span>
							<div><small>Effective choice</small><strong>{summarize(resolvedChoice.content)}</strong></div>
							<code>{resolvedChoice.sourceLayer} · {formatDate(resolvedChoice.sourceUpdated)}</code>
						</div>
						{conflict && (
							<div class="conflict-row">
								<Icon name="alert" size={16} />
								<div><small>Conflict preserved</small><span>{summarize(conflict.content, 78)}</span></div>
								<code>{conflict.layer} · {formatDate(conflict.updated)}</code>
							</div>
						)}
					</figure>
				</li>
			</ol>

			<div class="download-strip">
				<div>
					<strong>Use ContextCake with your own files.</strong>
					<span>ContextCake {appVersion} · Apple silicon</span>
				</div>
				<a class="button button--primary" href={appDownloadUrl} download>
					<Icon name="download" size={18} /> Download the DMG
				</a>
			</div>
		</section>

		<section class="source-install" id="source-install" aria-labelledby="source-title">
			<header class="section-intro section-intro--source">
				<div>
					<h2 id="source-title">Run the source version on Intel Mac, Linux, or WSL.</h2>
					<p>
						The Mac app requires Apple silicon. Use the versioned source for other supported
						platforms, contribution work, or a complete audit before you run anything.
					</p>
				</div>
				<span>Node.js 22+ · macOS, Linux, or WSL · no npm install</span>
			</header>

			<details class="source-details">
				<summary>
					<span><strong>Show source installation</strong><small>{sourceTag} · archive or Git</small></span>
					<span aria-hidden="true">+</span>
				</summary>
				<div class="source-details-body">
					<section class="source-route" aria-labelledby="archive-title">
						<div class="route-heading">
							<span>Source archive</span>
							<h3 id="archive-title">Download and verify the archive</h3>
							<p>The checksum verifies that the downloaded file matches the published release.</p>
						</div>
						<CodeBlock lang="bash" code={terminalDownload} label="Download tagged source" copy />
						<CodeBlock lang="bash" code={unpackCommand} label="Verify and unpack" copy />
						<p class="route-footnote">
							Prefer your browser? <a href={sourceDownloadUrl} download>Download the same .tar.gz</a>,
							then run the verification block above.
						</p>
					</section>

					<section class="source-route" aria-labelledby="git-title">
						<div class="route-heading">
							<span>Git checkout</span>
							<h3 id="git-title">Clone the tagged source</h3>
							<p>Use Git when you want a checkout for inspection, history, or contribution work.</p>
						</div>
						<CodeBlock lang="bash" code={gitCheckout} label="Clone with Git" copy />
						<details class="cli-alternative">
							<summary>Use GitHub CLI instead</summary>
							<CodeBlock lang="bash" code={githubCliCheckout} label="Clone with GitHub CLI" copy />
						</details>
					</section>

					<section class="resolver-proof" aria-labelledby="resolver-title">
						<div>
							<span>Included example</span>
							<h3 id="resolver-title">Run the bundled example</h3>
							<p>The result shows which source supplied each section and where another source differs.</p>
						</div>
						<CodeBlock lang="bash" code={resolveCommand} label="Resolve the demo" copy />
					</section>
				</div>
			</details>
		</section>

		<section class="trust" aria-labelledby="trust-title">
			<div>
				<Icon name="shield" size={24} />
				<h2 id="trust-title">How the Mac download is verified.</h2>
			</div>
			<div class="trust-copy">
					<p>
						The Mac app is Developer ID-signed and notarized. Each release lists the exact
						DMG and its checksum. Installed Macs reject an update unless it carries the same
						Developer ID signature. ContextCake reads only the sources you add.
				</p>
				<dl class="release-details">
					<div>
						<dt>Current release</dt>
						<dd><a href={appReleaseUrl}>{appTag}</a> · {appDownloadName}</dd>
					</div>
					<div>
						<dt>SHA-256</dt>
						<dd><code>{appDownloadSha256}</code> <a href={appChecksumsUrl}>View manifest</a></dd>
					</div>
					<div>
						<dt>Updates</dt>
						<dd>Checked over HTTPS; you choose whether to relaunch. <a href="/docs/reference/updates-and-privacy">Updates and privacy</a></dd>
					</div>
				</dl>
				<nav aria-label="Install trust links">
					<a href="/docs/concepts/trust-boundary">Read the trust model</a>
					<a href={sourceTagUrl}>Inspect source {sourceTag} <Icon name="external-link" size={15} /></a>
					<a href="/docs/getting-started/connect-an-agent">AI tool connection guide</a>
				</nav>
			</div>
		</section>
	</main>
</Base>

<style>
	.install-page {
		position: relative;
		z-index: 0;
		max-width: 76rem;
		margin: 0 auto;
		padding: 5rem 1.5rem 0;
	}
	.install-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.94fr) minmax(28rem, 1.06fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 5.5rem);
		min-height: 35rem;
		padding-bottom: 6rem;
	}
	.eyebrow {
		margin: 0;
		color: var(--cc-layer-team);
		font-family: var(--cc-font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	h1 {
		max-width: 13ch;
		margin: 1.15rem 0 1.35rem;
		font-size: clamp(2.4rem, 3.8vw, 4.25rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.lede {
		max-width: 39rem;
		margin: 0;
		color: var(--cc-text-body);
		font-size: clamp(1rem, 1.2vw, 1.15rem);
		line-height: 1.65;
		text-wrap: pretty;
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 2.9rem;
		padding: 0.2rem 1.15rem;
		border: 1px solid var(--cc-border-strong);
		border-radius: 999px;
		font-family: var(--cc-font-heading);
		font-weight: 700;
		text-decoration: none;
		transition: background var(--cc-transition), border-color var(--cc-transition), color var(--cc-transition);
	}
	.button--primary {
		border-color: var(--cc-cta);
		background: var(--cc-cta);
		color: var(--cc-on-cta);
	}
	.button--primary:hover {
		border-color: var(--cc-cta-hover);
		background: var(--cc-cta-hover);
	}
	:global(body.theme-paper) .button--primary {
		color: var(--cc-on-cta);
	}
	.download-module {
		margin-top: 2rem;
		border: 1px solid var(--cc-border-strong);
		border-radius: var(--cc-radius-md);
		background: color-mix(in srgb, var(--cc-surface-raised) 78%, var(--cc-layer-team));
		overflow: hidden;
	}
	.download-module__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.15rem 1.25rem;
	}
	.download-module__top > div { display: grid; gap: 0.18rem; }
	.download-module__top p {
		margin: 0;
		color: var(--cc-layer-team);
		font-family: var(--cc-font-mono);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.download-module__top h2 {
		margin: 0;
		color: var(--cc-text);
		font-size: 1.28rem;
		letter-spacing: -0.02em;
	}
	.download-module__top > div > span { color: var(--cc-text-body); font-size: 0.78rem; }
	.download-module__top .button { flex: none; }
	.download-record {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 1rem;
		padding: 0.7rem 1rem;
		color: var(--cc-text-muted);
		font-family: var(--cc-font-mono);
		font-size: 0.68rem;
	}
	.download-record a { color: var(--cc-text-body); text-underline-offset: 0.22rem; }
	.download-record a:hover { color: var(--cc-layer-team); }
	.install-alternatives {
		display: grid;
		gap: 0.45rem;
		margin-top: 1rem;
	}
	.install-alternatives a {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		width: fit-content;
		min-height: 2.75rem;
		color: var(--cc-text-body);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration-color: color-mix(in srgb, var(--cc-text-body) 42%, transparent);
		text-underline-offset: 0.28rem;
	}
	.install-alternatives a span { color: var(--cc-text-muted); font-weight: 500; }
	.install-alternatives a b { color: var(--cc-layer-team); }
	.install-alternatives a:hover { color: var(--cc-layer-team); }
	.mcpb-route {
		margin-top: 1.4rem;
		padding: 1rem 1.05rem;
		border: 1px solid color-mix(in srgb, var(--cc-layer-team) 34%, transparent);
		border-radius: 0.95rem;
		background: color-mix(in srgb, var(--cc-layer-team) 8%, transparent);
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.75rem 1rem;
		align-items: center;
	}
	.mcpb-route > div { display: grid; gap: 0.18rem; }
	.mcpb-route p { margin: 0; color: var(--cc-layer-team); font: 700 0.69rem/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
	.mcpb-route h2 { margin: 0; color: var(--cc-text); font-size: 1rem; }
	.mcpb-route span, .mcpb-route small { color: var(--cc-text-muted); font-size: 0.72rem; line-height: 1.45; }
	.mcpb-route small { grid-column: 1 / -1; }
	.mcpb-route small a { color: inherit; text-decoration: underline; text-underline-offset: 0.17em; }

	.app-preview {
		margin: 0;
		border: 1px solid var(--cc-border-strong);
		border-radius: 16px;
		background: var(--cc-surface-solid);
		overflow: hidden;
	}
	.window-bar {
		display: flex;
		align-items: center;
		gap: 0.42rem;
		min-height: 2.35rem;
		padding: 0 0.9rem;
		border-bottom: 1px solid var(--cc-border);
		background: var(--cc-surface-raised);
	}
	.window-bar > span {
		width: 0.58rem;
		height: 0.58rem;
		border-radius: 50%;
		background: var(--cc-text-faint);
		opacity: 0.55;
	}
	.window-bar strong {
		margin-left: auto;
		color: var(--cc-text-muted);
		font-size: 0.72rem;
		font-weight: 500;
	}
	.app-shell-preview {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr);
		min-height: 23rem;
	}
	.preview-sidebar {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.2rem 0.85rem;
		border-right: 1px solid var(--cc-border);
		background: color-mix(in srgb, var(--cc-canvas) 56%, var(--cc-surface-solid));
		color: var(--cc-text-muted);
		font-size: 0.72rem;
	}
	.preview-sidebar strong {
		margin: 0 0.35rem 0.8rem;
		color: var(--cc-text);
		font-size: 0.82rem;
	}
	.preview-sidebar span { padding: 0.48rem 0.55rem; border-radius: 7px; }
	.preview-sidebar .active { background: var(--cc-surface-soft); color: var(--cc-text); }
	.preview-content { padding: clamp(1.3rem, 3vw, 2.2rem); }
	.preview-content > p,
	.route-heading > span,
	.resolver-proof > div > span {
		margin: 0;
		color: var(--cc-layer-team);
		font-family: var(--cc-font-mono);
		font-size: 0.68rem;
		font-weight: 700;
	}
	.preview-content h2 {
		margin: 0.45rem 0 1.25rem;
		font-size: clamp(1.35rem, 2.6vw, 1.8rem);
		letter-spacing: -0.025em;
	}
	.folder-choice {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--cc-layer-team) 60%, var(--cc-border));
		border-radius: 10px;
		background: color-mix(in srgb, var(--cc-layer-team) 9%, var(--cc-surface));
		color: var(--cc-layer-team);
	}
	.folder-choice div { display: grid; gap: 0.12rem; }
	.folder-choice strong { color: var(--cc-text); font-size: 0.85rem; }
	.folder-choice span { color: var(--cc-text-muted); font-size: 0.7rem; }
	.folder-choice .selected-mark {
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: var(--cc-layer-team);
		color: var(--cc-canvas);
		font-weight: 700;
	}
	.preview-success {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 0.8rem;
		padding: 0.8rem 0.9rem;
		border-bottom: 1px solid var(--cc-border);
	}
	.preview-success > span {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--cc-layer-team);
	}
	.preview-success div { display: grid; gap: 0.05rem; }
	.preview-success strong { color: var(--cc-text); font-size: 0.78rem; }
	.preview-success small { color: var(--cc-text-muted); }
	.preview-action {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		min-height: 2.6rem;
		margin-top: 1rem;
		padding: 0 0.9rem;
		border-radius: 9px;
		background: var(--cc-cta);
		color: var(--cc-on-cta);
		font-size: 0.8rem;
		font-weight: 700;
	}
	.app-preview figcaption {
		padding: 0.7rem 1rem;
		border-top: 1px solid var(--cc-border);
		color: var(--cc-text-faint);
		font-size: 0.68rem;
		text-align: right;
	}

	.activation,
	.source-install,
