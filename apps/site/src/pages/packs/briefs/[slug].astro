---
import Base from '../../../layouts/Base.astro';
import { creatorBriefs } from '../../../data/commerce';

export function getStaticPaths() {
	return creatorBriefs.map((brief) => ({ params: { slug: brief.id }, props: { brief } }));
}

type CreatorBrief = (typeof creatorBriefs)[number];
const { brief } = Astro.props as { brief: CreatorBrief };
const applicationHref = `mailto:creators@contextcake.com?subject=${encodeURIComponent(`Creator application: ${brief.name}`)}&body=${encodeURIComponent(`Name:\nProfessional field:\n\nI am interested in the ${brief.name} creator brief because:\n\nRelevant materials I own or can license:\n\nRelated experience:\n`)}`;
const interestHref = `mailto:creators@contextcake.com?subject=${encodeURIComponent(`Buyer interest: ${brief.name}`)}&body=${encodeURIComponent(`Name:\nTeam or organization:\n\nI would use the ${brief.name} Pack for:\n\nThe most valuable part would be:\n`)}`;
---

<Base
	tone="paper"
	title={`${brief.name} creator brief | ContextCake Packs`}
	description={`${brief.summary} This is an open creator brief, not a published Pack.`}
>
	<main class="brief-page">
		<a class="back-link" href="/packs">← All Packs and briefs</a>

		<header class="brief-hero">
			<div class="hero-copy">
				<p class="eyebrow">Open creator brief · unpublished</p>
				<h1>{brief.name}</h1>
				<p class="lede">{brief.summary}</p>
				<div class="hero-actions">
					<a class="button primary" href={applicationHref}>Apply to create this Pack</a>
					<a class="button" href="/creators">How the creator program works</a>
				</div>
			</div>
			<aside class="brief-facts" aria-label="Creator brief facts">
				<p><span>Stage</span><strong>Seeking an expert creator</strong></p>
				<p><span>Best for</span><strong>{brief.audience}</strong></p>
				<p><span>Target license</span><strong>{brief.price.replace('Target ', '')} · {brief.teamPrice.replace('Target ', '')}</strong></p>
				<p><span>Proposed upkeep</span><strong>{brief.updateCadence}</strong></p>
			</aside>
		</header>

		<section class="outcome" aria-labelledby="outcome-title">
			<div><p class="eyebrow">The job</p><h2 id="outcome-title">One bounded workflow, start to finish.</h2></div>
			<div><p>{brief.outcome}</p><p class="workflow"><strong>Proposed hero workflow</strong>{brief.workflow}</p></div>
		</section>

		<section class="workflow-section" aria-labelledby="workflow-title">
			<div class="section-heading"><p class="eyebrow">Proposed workflow</p><h2 id="workflow-title">The Pack should help someone do this repeatedly.</h2></div>
			<ol>
				{brief.steps.map(([number, title, body]) => (
					<li><span>{number}</span><div><h3>{title}</h3><p>{body}</p></div></li>
				))}
			</ol>
		</section>

		<section class="build-brief" aria-labelledby="build-title">
			<div>
				<p class="eyebrow">What to build</p>
				<h2 id="build-title">Useful working material, not a pile of prompts.</h2>
				<p>The final scope is shaped with the creator. At minimum, this brief expects original workflows, rules, templates, examples, tool guidance, a safe local-overlay path, and a visible update policy.</p>
			</div>
			<ul>{brief.contents.map((item) => <li>{item}</li>)}</ul>
		</section>

		<section class="creator-fit" aria-labelledby="fit-title">
			<div><p class="eyebrow">Creator fit</p><h2 id="fit-title">Who should make it.</h2></div>
			<div>
				<p>{brief.creatorFit}</p>
				<p class="rights-note"><strong>Rights matter.</strong> You must own or be able to commercially license every included method, template, and example. Employer, client, student, and copied training material stay out.</p>
				<a class="button primary" href={applicationHref}>Apply for this brief</a>
				<a class="text-link" href={`mailto:creators@contextcake.com?subject=${encodeURIComponent('My own ContextCake Pack idea')}`}>Or pitch a different Pack →</a>
			</div>
		</section>

		<aside class="stage-note">
			<div><strong>This is not a product listing yet.</strong><p>No Pack has been approved or published, and no final price is set. There is no preorder or checkout. A listing becomes purchasable only after the content and rights review passes.</p></div>
			<a href={interestHref}>I’d use this Pack →</a>
		</aside>
	</main>
</Base>

<style>
	.brief-page { max-width: 88rem; margin: 0 auto; padding: 1.5rem clamp(1.25rem, 4vw, 4rem) 6rem; color: var(--cc-text-body); }
	.back-link { display: inline-flex; min-height: 44px; align-items: center; color: var(--cc-text-muted); font-weight: 700; text-decoration: none; }
	.back-link:hover { color: var(--cc-text); }
	.eyebrow { margin: 0 0 1rem; color: var(--cc-text-muted); font-family: var(--cc-font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	h1, h2, h3, p { letter-spacing: 0; }
	.brief-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.55fr); gap: clamp(3rem, 6vw, 6rem); align-items: end; min-height: 31rem; padding: clamp(2.5rem, 5vw, 5rem) 0; border-bottom: 1px solid var(--cc-border-strong); }
	h1 { max-width: 16ch; margin: 0; color: var(--cc-text); font-size: clamp(2.5rem, 4.6vw, 5rem); line-height: 0.98; letter-spacing: -0.04em; text-wrap: balance; }
	.lede { max-width: 50rem; margin: 1.5rem 0 0; font-size: clamp(1.08rem, 1.4vw, 1.3rem); line-height: 1.6; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
	.button { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.1rem; border: 1px solid var(--cc-border-strong); color: var(--cc-text); font-weight: 700; text-decoration: none; }
	.button.primary { border-color: var(--cc-text); background: var(--cc-text); color: var(--cc-surface-solid); }
	.button:hover { background: var(--cc-surface-soft); }
	.button.primary:hover { background: var(--cc-text-body); }
	.brief-facts { border-top: 0.4rem solid var(--cc-layer-team); }
	.brief-facts p { display: grid; gap: 0.3rem; margin: 0; padding: 1rem 0; border-bottom: 1px solid var(--cc-border-strong); }
	.brief-facts span { color: var(--cc-text-muted); font-family: var(--cc-font-mono); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; }
	.brief-facts strong { color: var(--cc-text); line-height: 1.45; }
	.outcome, .build-brief, .creator-fit { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 7vw, 7rem); padding: clamp(4rem, 7vw, 7rem) 0; border-bottom: 1px solid var(--cc-border-strong); }
	h2 { max-width: 18ch; margin: 0; color: var(--cc-text); font-size: clamp(2rem, 3.4vw, 3.4rem); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
	.outcome > div:last-child > p:first-child, .creator-fit > div:last-child > p:first-child { margin: 0; color: var(--cc-text); font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.55; }
	.workflow { display: grid; gap: 0.45rem; margin: 2rem 0 0; padding: 1.25rem; border-left: 0.35rem solid var(--cc-layer-personal); background: var(--cc-surface-soft); line-height: 1.6; }
	.workflow strong { color: var(--cc-text); }
	.workflow-section { padding: clamp(4rem, 7vw, 7rem) 0; border-bottom: 1px solid var(--cc-border-strong); }
	.section-heading { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; }
	.section-heading h2 { max-width: 24ch; }
	.workflow-section ol { margin: 3rem 0 0; padding: 0; border-top: 1px solid var(--cc-border-strong); list-style: none; }
	.workflow-section li { display: grid; grid-template-columns: 4rem 12rem minmax(0, 1fr); gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--cc-border); }
	.workflow-section li > span { color: var(--cc-layer-team); font-family: var(--cc-font-mono); font-size: 0.75rem; font-weight: 700; }
	.workflow-section h3 { margin: 0; color: var(--cc-text); font-size: 1.3rem; }
	.workflow-section li p { margin: 0; line-height: 1.6; }
	.build-brief > div > p:last-child { max-width: 54ch; line-height: 1.65; }
	.build-brief ul { margin: 0; padding: 0; border-top: 1px solid var(--cc-border-strong); list-style: none; }
	.build-brief li { position: relative; padding: 1.2rem 0 1.2rem 2rem; border-bottom: 1px solid var(--cc-border-strong); color: var(--cc-text); font-weight: 700; }
	.build-brief li::before { content: '✓'; position: absolute; left: 0; color: var(--cc-layer-team); }
	.creator-fit > div:last-child { max-width: 58ch; }
	.rights-note { margin: 2rem 0; padding-top: 1.25rem; border-top: 1px solid var(--cc-border-strong); line-height: 1.6; }
	.rights-note strong { color: var(--cc-text); }
	.text-link { display: inline-flex; min-height: 44px; align-items: center; margin-left: 1rem; color: var(--cc-text); font-weight: 700; }
	.stage-note { display: flex; gap: 2rem; align-items: center; justify-content: space-between; margin-top: 2rem; padding: 1.5rem; border-left: 0.4rem solid var(--cc-layer-company); background: var(--cc-surface-soft); }
	.stage-note strong { color: var(--cc-text); }
	.stage-note p { margin: 0.4rem 0 0; line-height: 1.6; }
	.stage-note a { flex: 0 0 auto; color: var(--cc-text); font-weight: 700; }
	@media (max-width: 820px) { .brief-hero, .outcome, .build-brief, .creator-fit { grid-template-columns: 1fr; } .brief-hero { min-height: auto; } .section-heading { grid-template-columns: 1fr; gap: 0; } }
	@media (max-width: 640px) { .brief-page { padding-inline: 1rem; } .workflow-section li { grid-template-columns: 2.5rem minmax(0, 1fr); } .workflow-section li p { grid-column: 2; margin-top: 0.35rem; } .text-link { display: flex; margin: 0.75rem 0 0; } .stage-note { align-items: flex-start; flex-direction: column; } }
</style>
