---
import { fileURLToPath } from 'node:url';
import PackProductPage from '../../components/PackProductPage.astro';
import { COMMERCE_VISIBLE } from '../../config/flags';
import { loadPackExplorer } from '../../lib/pack-explorer';

const packRoot = fileURLToPath(
	new URL('../../../../../specs/contextcake-packs/packs/contextcake', import.meta.url),
);
const explorer = await loadPackExplorer(packRoot, 'contextcake');
const fileCount = explorer.files.length;
const folderCount = explorer.treeEntries.filter((entry) => entry.kind === 'dir').length;

const featuredFiles = [
	{ label: 'Start here', path: 'START-HERE.md' },
	{ label: 'What it is', path: 'overview/what-is-contextcake.md' },
	{ label: 'Layers', path: 'architecture/layers-and-precedence.md' },
	{ label: 'Install', path: 'getting-started/installation.md' },
	{ label: 'Changelog', path: 'updates/CHANGELOG.md' },
];

// Plan names and the pricing page only appear while commerce is visible
// (src/config/flags.json); the Pack itself is free either way.
const faqs = [
	{ q: 'Is this just the ContextCake docs?', a: 'The facts overlap, but this Pack can live inside a project and travel with an AI agent.' },
	{ q: 'Do I need it to use ContextCake?', a: 'No. It gives your assistant a local reference for setup, architecture, and common mistakes.' },
	{ q: 'How current is it?', a: 'It was reviewed on July 17, 2026. Every release carries a freshness date and visible changelog.' },
	...(COMMERCE_VISIBLE
		? [{ q: 'What becomes paid later?', a: 'Not this Pack. Managed sync and other professional Packs may be paid separately.' }]
		: []),
];
---

<PackProductPage
	accent="team"
	seoTitle="ContextCake Context Pack"
	seoDescription="A free ContextCake Pack covering setup, architecture, OKF, the resolver, MCP tools, examples, and common mistakes."
	name="ContextCake Context Pack"
	status="Available free"
	headline="Keep the ContextCake reference inside your project."
	lede="Architecture, setup, examples, and the sharp edges worth knowing, kept in files your assistant can reference while you work."
	actions={[
		{ label: 'Browse the files', href: '#explorer', primary: true },
		{ label: 'License & updates', href: '#availability' },
	]}
	quickFacts={[
		['Creator', 'ContextCake'],
		['License', 'Free · MIT'],
		['Reviewed', 'July 17, 2026'],
		['Permissions', 'Content only'],
	]}
	fitRows={[
		['Good for', 'Developers and AI agents adopting or extending ContextCake.'],
		['Not for', 'A general marketing overview; the rest of the site already covers that.'],
		['Delivery', 'A complete Markdown Pack you can read and edit.'],
	]}
	valuePoints={[
		'What ContextCake is and the mental model',
		'Architecture, sources, resolver, and conflicts',
		'Install, first cascade, and writing a layer',
		'MCP tools and connecting an AI agent',
	]}
	workflow={{
		title: 'From mental model to connected agent',
		description: 'The Pack has a deliberate reading path. Start with how the layers resolve, then run it, write your own context, and connect the agent you already use.',
		steps: [
			['01', 'Understand', 'Learn what ContextCake stores and why resolution happens section by section.'],
			['02', 'Install', 'Run the dependency-free engine and resolve a first cascade.'],
			['03', 'Write a layer', 'Create OKF concepts with anchored sections other layers can override.'],
			['04', 'Connect an agent', 'Point Claude, Cursor, or another MCP client at the resolved graph.'],
		],
	}}
	explorer={explorer}
	explorerCopy={{
		id: 'contextcake-pack-explorer',
		title: 'Browse the complete Pack',
		description: 'Search the file tree or start with a featured file. Switch between rendered Markdown and source when the exact structure matters.',
		featuredFiles,
		defaultFile: 'START-HERE.md',
		treeLabel: 'ContextCake Pack files',
	}}
	availability={{
		id: 'availability',
		title: 'Free to read, install, and keep',
		description: COMMERCE_VISIBLE
			? 'This first-party Pack and its corrections stay free. You don’t need ContextCake Pro or an account to use it.'
			: 'This first-party Pack and its corrections stay free. You don’t need an account to use it.',
		plans: [{
			label: 'Free Pack',
			price: 'Free',
			priceSuffix: 'forever',
			cadence: 'Full Pack · corrections included · no account',
			body: `All ${fileCount} files across ${folderCount} directories, with source disclosure, permissions, freshness date, and changelog visible before use.`,
			href: '#explorer',
			link: 'Read the full Pack',
			primary: true,
		}],
		note: COMMERCE_VISIBLE
			? 'No checkout is attached to this Pack. Its content, license, file tree, and changelog are available above.'
			: 'Nothing to sign up for. The Pack’s content, license, file tree, and changelog are above.',
	}}
	useCases={[
		['Adopting ContextCake', 'Add ContextCake to a repository with an accurate reference for setup and conventions.'],
		['Onboarding a teammate', 'Share the architecture without asking someone to read the whole codebase.'],
		['Building on the engine', 'Keep source, resolver, and MCP behavior close at hand while extending it.'],
		['Briefing an AI tool', 'Give ChatGPT, Cursor, or Copilot current facts instead of stale guesses.'],
	]}
	insideRows={[
		['Architecture', 'Federated storage, the resolver, section merges, provenance, and conflicts.'],
		['Agent connection', 'MCP and tool-specific walkthroughs for using ContextCake in a repository.'],
		['Working examples', 'A full OKF concept, layers.json, and resolved read_file payload.'],
		['Sharp edges', 'Precedence, recency, trust boundaries, and the dependency-free core.'],
	]}
	compatibility={{
		title: 'Use it with the tools you already have',
		rows: [
			['Plain files', 'Open and edit the Markdown in any text editor.'],
			['Claude Code', 'Add the ContextCake MCP server or point Claude at the Pack files.'],
			['ChatGPT', 'Upload the files as project or knowledge files.'],
			['Cursor & Copilot', 'Keep the files in your repo as working context.'],
		],
	}}
	trustRows={[
		['Source', 'First-party reference material maintained by ContextCake.'],
		['Permissions', 'Content only. No scripts, network access, credentials, or hidden services.'],
		['Updates', 'Corrections remain free and every release keeps a visible changelog.'],
	]}
	faqs={faqs}
	credibility="Made and reviewed by ContextCake. Pack Contract v1 · content only · no scripts, network access, credentials, or hidden services."
	credibilityLinks={COMMERCE_VISIBLE ? [{ label: 'See app pricing', href: '/pricing' }] : []}
/>
