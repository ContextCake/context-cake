---
import { fileURLToPath } from 'node:url';
import PackProductPage from '../../components/PackProductPage.astro';
import { loadPackExplorer } from '../../lib/pack-explorer';

const packRoot = fileURLToPath(
	new URL(
		'../../../../../specs/contextcake-packs/private-repo-template/packs/data-analytics-team',
		import.meta.url,
	),
);
const explorer = await loadPackExplorer(packRoot, 'data-analytics-team');
const fileCount = explorer.files.length;
const folderCount = explorer.treeEntries.filter((entry) => entry.kind === 'dir').length;

// Checkout stays dormant while the complete Pack ships as a free preview.
const LEMONSQUEEZY_BASE_PACK_URL = 'https://STORE.lemonsqueezy.com/buy/REPLACE_BASE_PACK';
const LEMONSQUEEZY_TEAM_PACK_URL = 'https://STORE.lemonsqueezy.com/buy/REPLACE_TEAM_PACK';
const LEMONSQUEEZY_UPDATES_URL = 'https://STORE.lemonsqueezy.com/buy/REPLACE_UPDATES';
const paymentsLive = false;

const featuredFiles = [
	{ label: 'Start here', path: 'skills/data-analytics-team-pack/START-HERE.md' },
	{ label: 'Request flow', path: 'skills/data-analytics-team-pack/workflows/request-clarification.md' },
	{ label: 'Spec template', path: 'skills/data-analytics-team-pack/templates/clarified-spec-template.md' },
	{ label: 'Source rules', path: 'skills/data-analytics-team-pack/policies-and-rules/source-of-truth-precedence.md' },
];

const availabilityPlans = paymentsLive
	? [
		{
			label: 'Personal license', price: '$99', priceSuffix: 'one-time',
			cadence: 'One named user · yours to keep.',
			body: 'The complete Pack as plain files, with workflows, templates, examples, policies, and cross-tool guidance.',
			href: LEMONSQUEEZY_BASE_PACK_URL, link: 'Buy personal', primary: true,
		},
		{
			label: 'Team license', price: '$249', priceSuffix: 'one-time',
			cadence: 'Up to five named users.',
			body: 'The same complete Pack licensed for a small analytics team, with the delivered version retained permanently.',
			href: LEMONSQUEEZY_TEAM_PACK_URL, link: 'Buy for a team',
		},
		{
			label: 'Optional updates', price: '$9', priceSuffix: '/ month',
			cadence: 'Personal editorial updates.',
			body: 'Later examples, guidance, and templates arrive as reviewable releases. The base Pack keeps working without them.',
			href: LEMONSQUEEZY_UPDATES_URL, link: 'Add updates',
		},
	]
	: [
		{
			label: 'Preview open now', price: 'Free', priceSuffix: 'in preview',
			cadence: 'Read the complete Pack before commercial launch.',
			body: `Inspect all ${fileCount} files across ${folderCount} directories, including the workflows, templates, examples, policies, and tool guides.`,
			href: '#explorer', link: 'Read the full Pack', primary: true,
		},
		{
			label: 'Personal license', price: '$99', priceSuffix: 'one-time',
			cadence: 'One named user · yours to keep.',
			body: 'The full Pack as plain files with cross-tool guidance. ContextCake Pro is not required.',
			link: 'Coming soon', disabled: true,
		},
		{
			label: 'Team license', price: '$249', priceSuffix: 'one-time',
			cadence: 'Up to five named users.',
			body: 'Optional editorial updates are planned separately. Canceling updates never disables files you already have.',
			link: 'Coming soon', disabled: true,
		},
	];
---

<PackProductPage
	accent="personal"
	seoTitle="ContextCake Pack: Data & Analytics Teams"
	seoDescription="A file-based Pack for data teams that need repeatable request scoping, validation, and insight delivery standards across AI tools."
	name="Data & Analytics Teams"
	status="Free preview"
	headline="A working kit for recurring analytics requests."
	lede="Use the same process each time a stakeholder asks for a metric, dashboard, or analysis: clarify the request, agree on the definition, validate the result, and explain the answer."
	actions={[
		{ label: 'Browse the files', href: '#explorer', primary: true },
		{ label: 'Preview & pricing', href: '#availability' },
	]}
	quickFacts={[
		['Creator', 'ContextCake'],
		['License', '$99 personal · $249 team'],
		['Reviewed', 'July 17, 2026'],
		['Permissions', 'Content only'],
	]}
	fitRows={[
		['Good for', 'Small data and analytics teams handling recurring stakeholder requests.'],
		['Not for', 'Teams shopping for a BI tool, warehouse connector, or live metrics product.'],
		['Delivery', 'Plain Markdown files with optional Claude Code packaging.'],
	]}
	valuePoints={[
		'Clarification workflow for vague requests',
		'Source-of-truth and validation rules',
		'Spec, checklist, and summary templates',
		'Local overlay guidance for team-specific edits',
	]}
	workflow={{
		title: 'One request, four written steps',
		description: 'The Pack turns the usual path from request to delivery into a process the team can repeat, review, and improve.',
		steps: [
			['01', 'Clarify', 'Turn the ask into a written spec with definitions, source, and acceptance criteria.'],
			['02', 'Build', 'Create the query, model, or report from the definition the team agreed to.'],
			['03', 'Validate', 'Reconcile the result to the source of truth before a stakeholder sees it.'],
			['04', 'Deliver', 'Send the answer with confidence, caveats, and a clear next action.'],
		],
	}}
	explorer={explorer}
	explorerCopy={{
		id: 'data-analytics-pack-explorer',
		title: 'Browse the complete Pack',
		description: 'Search the file tree or start with the request workflow, spec template, and source-of-truth rules.',
		featuredFiles,
		defaultFile: 'skills/data-analytics-team-pack/START-HERE.md',
		treeLabel: 'Data & Analytics Teams Pack files',
	}}
	availability={{
		id: 'availability',
		title: paymentsLive ? 'Buy once. Add updates only if they help.' : 'Read it now. Paid licenses come later.',
		description: paymentsLive
			? 'The base Pack is a one-time purchase. A separate subscription adds future editorial releases but is not required to keep using what you bought.'
			: 'The full Pack is open during preview. Commercial pricing is set; checkout remains off until fulfillment and entitlements are ready.',
		plans: availabilityPlans,
		note: paymentsLive ? undefined : 'No checkout yet. The complete Pack stays open for inspection while fulfillment, entitlements, and update delivery are finished.',
	}}
	useCases={[
		['Dashboard requests', 'Handle the same stakeholder question when it returns with slightly different framing.'],
		['Analyst onboarding', 'Give new team members the standards without sending them through old chats.'],
		['AI drafting guardrails', 'Let an AI tool draft while keeping the team’s rules and boundaries in view.'],
		['Insight delivery', 'Send the answer, caveats, confidence, and next action in one summary.'],
	]}
	insideRows={[
		['Request clarification', 'A workflow and spec template that reduce back-and-forth on vague asks.'],
		['Source-of-truth rules', 'Metric and precedence guidance that keeps answers consistent.'],
		['Validation and delivery', 'A checklist and insight-summary template that make confidence explicit.'],
		['Local overlay', 'A safe place for team-specific policies and examples that survives updates.'],
	]}
	compatibility={{
		title: 'Use the Markdown directly or with your AI tool',
		rows: [
			['Plain files', 'Open and edit the Markdown in any text editor.'],
			['Claude Code', 'Install as a plugin or point Claude at the unzipped files.'],
			['ChatGPT', 'Upload the files as project or knowledge files.'],
			['Cursor & Copilot', 'Keep the files in your repo as working context.'],
		],
	}}
	trustRows={[
		['Source', 'Original first-party workflows, templates, examples, and guidance.'],
		['Rights', 'ContextCake owns or can commercially distribute every included item.'],
		['Permissions', 'No executable code, network access, bundled server, credentials, or escaping symlinks.'],
		['Updates', 'Corrections remain available; new editorial releases may be licensed separately.'],
	]}
	faqs={[
		{ q: 'Is this a BI tool or data catalog?', a: 'No. It’s a file-based working kit and doesn’t connect to your warehouse or manage live data.' },
		{ q: 'Do we need special software?', a: 'No. Plain files are the baseline. Claude Code packaging is optional.' },
		{ q: 'Can we customize it?', a: 'Yes. Keep team-specific rules in a separate local overlay so Pack updates remain easy to review.' },
		{ q: 'What do optional updates include?', a: 'Curated editorial releases with clearer examples, sharper guidance, and new templates.' },
		{ q: 'Do I need ContextCake Pro?', a: 'No. Packs are separate products, and the Free app can install any Pack you own.' },
	]}
	credibility="Made and reviewed by ContextCake. Pack Contract v1 · content only · no scripts, network access, credentials, or bundled services."
	credibilityLinks={[
		{ label: 'Create a Pack', href: '/creators' },
		{ label: 'See app pricing', href: '/pricing' },
	]}
/>
