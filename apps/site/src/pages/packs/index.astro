---
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { catalogPacks, creatorBriefs } from '../../data/commerce';

const catalogEntries = [...catalogPacks, ...creatorBriefs];
const publishedCount = catalogPacks.length;
const briefCount = creatorBriefs.length;

const structurePreview = `profession-pack/
├── START-HERE.md
├── PACK.yaml
├── overview/
├── workflows/
├── policies-and-rules/
├── templates/
├── examples/
├── tool-guides/
├── local-overlay/
└── updates/CHANGELOG.md`;
---

<Base
	title="ContextCake Packs | inspectable professional workflows"
	description="Browse workflow Packs with visible files, creators, permissions, licenses, and update policies."
>
	<main class="packs-page">
		<header class="catalog-intro">
			<div>
				<h1>Packs</h1>
				<p>Inspectable workflow kits—and open briefs for the people who should create the next ones.</p>
				<div class="intro-actions">
					<a href="#catalog-title">Browse the catalog</a>
					<a href="/creators">Become a creator</a>
				</div>
			</div>
			<div class="intro-note">
				<strong>{publishedCount} published · {briefCount} open briefs</strong>
				<span>Published Packs are ready to inspect. Open briefs are unpublished opportunities for qualified creators—not preorders.</span>
			</div>
		</header>

		<section class="catalog-shell" aria-labelledby="catalog-title" data-pack-catalog>
			<header class="catalog-toolbar">
				<div class="catalog-title-group">
					<h2 id="catalog-title">Browse Packs and creator briefs</h2>
					<p aria-live="polite" data-result-count>{publishedCount} published · {briefCount} open briefs</p>
				</div>
				<div class="catalog-controls">
					<label class="search-control">
						<span>Search</span>
						<input type="search" placeholder="Name, workflow, or tool" autocomplete="off" data-pack-search />
					</label>
					<label class="sort-control">
						<span>Stage</span>
						<select data-pack-stage>
							<option value="all">All</option>
							<option value="published">Published</option>
							<option value="brief">Open briefs</option>
						</select>
					</label>
					<label class="sort-control">
						<span>Sort</span>
						<select data-pack-sort>
							<option value="featured">Featured</option>
							<option value="name">Name A–Z</option>
							<option value="reviewed">Recently reviewed</option>
						</select>
					</label>
					<button class="clear-search" type="button" data-clear-search hidden>Clear</button>
				</div>
			</header>

			<div class="catalog-table" role="table" aria-label="ContextCake Pack catalog">
				<div class="catalog-head" role="row">
					<span role="columnheader">Pack</span>
					<span role="columnheader">Best for</span>
					<span role="columnheader">License</span>
					<span role="columnheader">Stage</span>
					<span role="columnheader" class="sr-only">Open</span>
				</div>
				<div class="catalog-body" role="rowgroup" data-pack-list>
					{catalogEntries.map((pack, index) => (
						<div
							class={`pack-record pack-record--${pack.accent}`}
							role="row"
							data-pack-row
							data-order={index}
							data-kind={pack.kind}
							data-name={pack.name.toLocaleLowerCase()}
							data-reviewed={pack.reviewedSort}
							data-search={[pack.name, pack.creator, pack.category, pack.audience, pack.summary, pack.workflow, pack.formats.join(' ')].join(' ').toLocaleLowerCase()}
						>
							<div class="pack-cell pack-identity" role="cell">
								<p class="pack-status"><i aria-hidden="true"></i>{pack.status}<span>· by {pack.creator}</span></p>
								<h3><a href={pack.href}>{pack.name}</a></h3>
								<p>{pack.summary}</p>
							</div>
							<div class="pack-cell pack-audience" role="cell">
								<strong>{pack.category}</strong>
								<span>{pack.audience}</span>
							</div>
							<div class="pack-cell pack-license" role="cell">
								<strong>{pack.price}</strong>
								{pack.teamPrice !== pack.price && <span>{pack.teamPrice}</span>}
							</div>
							<div class="pack-cell pack-reviewed" role="cell">
								{pack.kind === 'published' ? <time datetime={pack.reviewedSort}>{pack.reviewedAt}</time> : <strong>Unpublished</strong>}
								<span>{pack.updateCadence}</span>
							</div>
							<div class="pack-open" role="cell"><a href={pack.href} aria-label={`Open ${pack.name}`}>View <span aria-hidden="true">→</span></a></div>
						</div>
					))}
				</div>
			</div>

			<div class="empty-state" data-empty-state hidden>
				<strong>No Packs match that search.</strong>
				<p>Try a broader workflow, profession, tool name, or stage.</p>
				<button type="button" data-empty-clear>Clear search</button>
			</div>
			<footer class="catalog-footer">
				<p>Open briefs are invitations to create, not products. Ratings appear only after verified purchases.</p>
				<a href="/creators">Pitch your own Pack</a>
			</footer>
		</section>

		<section class="pack-standard" aria-labelledby="standard-title">
			<div class="standard-heading">
				<h2 id="standard-title">Every Pack follows the same inspection model.</h2>
				<p>Each Pack makes its files, creator, permissions, and update path visible, even when the folder layout reflects a different workflow.</p>
			</div>
			<ol class="standard-steps">
				<li><span>01</span><div><strong>Inspect</strong><p>Read the files, creator, permissions, license, and changelog.</p></div></li>
				<li><span>02</span><div><strong>Adapt</strong><p>Keep team and personal exceptions in a separate local overlay.</p></div></li>
				<li><span>03</span><div><strong>Update safely</strong><p>Review what changed, install it, or roll back without replacing local work.</p></div></li>
			</ol>

			<details class="contract-details">
				<summary>See a typical Pack structure</summary>
				<div>
					<CodeBlock className="tree-preview" lang="text" code={structurePreview} />
					<p><strong>START-HERE.md</strong> explains the job and reading order. Workflows, rules, templates, and examples carry the method. <strong>local-overlay/</strong> protects your changes; <strong>updates/</strong> makes every release reviewable.</p>
				</div>
			</details>
		</section>
	</main>
</Base>

<style>
	.packs-page { max-width: 82rem; margin: 0 auto; padding: 0 1.5rem 3rem; }
	.catalog-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
		padding: clamp(3.5rem, 7vw, 6.5rem) 0 2.5rem;
	}
	h1, h2, h3, p { letter-spacing: 0; }
	h1 { margin: 0; font-size: clamp(2.4rem, 3.8vw, 4.1rem); line-height: 1.05; letter-spacing: -0.03em; }
	.catalog-intro > div:first-child p { max-width: 30ch; margin: 1rem 0 0; color: var(--cc-text-body); font-size: clamp(1.05rem, 1.3vw, 1.25rem); line-height: 1.5; text-wrap: balance; }
	.intro-note { padding-top: 1rem; border-top: 3px solid var(--cc-layer-team); }
	.intro-note strong, .intro-note span { display: block; }
	.intro-note strong { color: var(--cc-text); }
	.intro-note span { margin-top: 0.4rem; color: var(--cc-text-body); line-height: 1.55; }
	.intro-actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.5rem; }
	.intro-actions a { color: var(--cc-text); font-weight: 700; text-underline-offset: 0.22em; }
	.catalog-shell { overflow: hidden; border: 1px solid var(--cc-border-strong); border-radius: var(--cc-radius-md); background: var(--cc-surface); }
	.catalog-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 1rem 2rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--cc-border-strong); }
	.catalog-title-group h2 { margin: 0; font-size: 1.2rem; }
	.catalog-title-group p { margin: 0.2rem 0 0; color: var(--cc-text-muted); font-size: 0.85rem; }
	.catalog-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 0.6rem; }
	.search-control, .sort-control { display: grid; gap: 0.3rem; }
	.search-control span, .sort-control span { color: var(--cc-text-muted); font-family: var(--cc-font-mono); font-size: 0.68rem; font-weight: 700; }
	.search-control input, .sort-control select {
		height: 44px;
		box-sizing: border-box;
		border: 1px solid var(--cc-border-strong);
		border-radius: var(--cc-radius-sm);
		background: var(--cc-surface-solid);
		color: var(--cc-text);
		font: inherit;
	}
	.search-control input { width: min(22rem, 42vw); padding: 0 0.8rem; }
	.search-control input::placeholder { color: var(--cc-text-muted); opacity: 1; }
	.sort-control select { min-width: 10.5rem; padding: 0 2rem 0 0.7rem; }
	.clear-search, .empty-state button {
		height: 44px;
		padding: 0 0.8rem;
		border: 0;
		background: transparent;
		color: var(--cc-text);
		font: inherit;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}
	.catalog-head, .pack-record { display: grid; grid-template-columns: minmax(17rem, 2fr) minmax(12rem, 1.15fr) minmax(8rem, 0.75fr) minmax(9rem, 0.85fr) 4.5rem; gap: 1rem; align-items: center; }
	.catalog-head { padding: 0.65rem 1.1rem; border-bottom: 1px solid var(--cc-border); color: var(--cc-text-muted); font-family: var(--cc-font-mono); font-size: 0.68rem; font-weight: 700; }
	.pack-record { --row-accent: var(--cc-layer-team); position: relative; padding: 1.15rem 1.1rem; background: transparent; transition: background var(--cc-transition); }
	.pack-record--personal { --row-accent: var(--cc-layer-personal); }
	.pack-record--company { --row-accent: var(--cc-layer-company); }
	.pack-record + .pack-record { border-top: 1px solid var(--cc-border); }
	.pack-record:hover, .pack-record:focus-within { background: var(--cc-surface-soft); }
	.pack-cell { min-width: 0; }
	.pack-status { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.35rem; color: var(--cc-text-muted); font-family: var(--cc-font-mono); font-size: 0.68rem; font-weight: 700; }
	.pack-status i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--row-accent); }
	.pack-status span { color: var(--cc-text-faint); font-weight: 500; }
	.pack-identity h3 { margin: 0; font-size: 1.22rem; line-height: 1.2; }
	.pack-identity h3 a { color: var(--cc-text); text-decoration: none; }
	.pack-identity h3 a::after { content: ''; position: absolute; inset: 0; }
	.pack-identity > p:last-child { max-width: 54ch; margin: 0.4rem 0 0; color: var(--cc-text-body); font-size: 0.92rem; line-height: 1.5; }
	.pack-audience, .pack-license, .pack-reviewed { display: grid; gap: 0.25rem; }
	.pack-audience strong, .pack-license strong, .pack-reviewed time, .pack-reviewed strong { color: var(--cc-text); font-size: 0.9rem; font-weight: 700; }
	.pack-audience span, .pack-license span, .pack-reviewed span { color: var(--cc-text-muted); font-size: 0.82rem; line-height: 1.4; }
	.pack-open { justify-self: end; }
	.pack-open a { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; color: var(--cc-text); font-weight: 700; text-decoration: none; }
	.empty-state { padding: 3rem 1.25rem; text-align: center; }
	.empty-state strong { color: var(--cc-text); font-size: 1.15rem; }
	.empty-state p { margin: 0.35rem 0 0; color: var(--cc-text-muted); }
	.catalog-footer { display: flex; justify-content: space-between; gap: 1rem 2rem; padding: 0.8rem 1.1rem; border-top: 1px solid var(--cc-border-strong); }
	.catalog-footer p { margin: 0; color: var(--cc-text-muted); font-size: 0.82rem; }
	.catalog-footer a { color: var(--cc-text); font-weight: 700; white-space: nowrap; }
	.pack-standard { padding: 5rem 0 1rem; }
	.standard-heading { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 2rem; align-items: end; }
	.standard-heading h2 { max-width: 18ch; margin: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.05; text-wrap: balance; }
	.standard-heading p { max-width: 58ch; margin: 0; color: var(--cc-text-body); line-height: 1.6; }
	.standard-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 2rem 0 0; padding: 0; border-block: 1px solid var(--cc-border-strong); list-style: none; }
	.standard-steps li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.7rem; padding: 1.2rem 1rem 1.2rem 0; }
	.standard-steps li + li { padding-left: 1rem; border-left: 1px solid var(--cc-border); }
	.standard-steps span { color: var(--cc-layer-team); font-family: var(--cc-font-mono); font-size: 0.72rem; font-weight: 700; }
	.standard-steps strong { color: var(--cc-text); }
	.standard-steps p { margin: 0.3rem 0 0; color: var(--cc-text-body); font-size: 0.92rem; line-height: 1.5; }
	.contract-details { margin-top: 1.25rem; border-bottom: 1px solid var(--cc-border-strong); }
	.contract-details summary { display: flex; align-items: center; min-height: 48px; color: var(--cc-text); cursor: pointer; font-weight: 700; }
	.contract-details > div { display: grid; grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1fr); gap: 2rem; align-items: start; padding: 0.5rem 0 2rem; }
	.contract-details p { max-width: 56ch; margin: 0; color: var(--cc-text-body); line-height: 1.65; }
	.contract-details :global(.tree-preview .shiki) { margin: 0; font-size: 0.82rem; }
	@media (max-width: 960px) {
		.catalog-head, .pack-record { grid-template-columns: minmax(16rem, 1.7fr) minmax(11rem, 1fr) minmax(8rem, 0.7fr) 4rem; }
		.catalog-head > :nth-child(4), .pack-reviewed { display: none; }
	}
	@media (max-width: 760px) {
		.packs-page { padding-inline: 1rem; }
		.catalog-intro, .standard-heading, .contract-details > div { grid-template-columns: 1fr; }
		.catalog-intro { padding-block: 3rem 2rem; }
		.catalog-toolbar { align-items: stretch; flex-direction: column; }
		.catalog-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
		.search-control { grid-column: 1 / -1; }
		.search-control input { width: 100%; }
		.catalog-head { display: none; }
		.pack-record { grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; }
		.pack-identity { grid-column: 1 / -1; }
		.pack-audience { grid-column: 1 / -1; }
		.pack-license { grid-column: 1; }
		.pack-open { grid-column: 2; grid-row: 3; }
		.catalog-footer { align-items: start; flex-direction: column; }
		.standard-steps { grid-template-columns: 1fr; }
		.standard-steps li + li { padding-left: 0; border-top: 1px solid var(--cc-border); border-left: 0; }
	}
	@media (prefers-reduced-motion: reduce) { .pack-record { transition: none; } }
</style>

<script>
	const catalog = document.querySelector<HTMLElement>('[data-pack-catalog]');
	if (catalog) {
		const search = catalog.querySelector<HTMLInputElement>('[data-pack-search]');
		const stage = catalog.querySelector<HTMLSelectElement>('[data-pack-stage]');
		const sort = catalog.querySelector<HTMLSelectElement>('[data-pack-sort]');
		const list = catalog.querySelector<HTMLElement>('[data-pack-list]');
		const count = catalog.querySelector<HTMLElement>('[data-result-count]');
		const empty = catalog.querySelector<HTMLElement>('[data-empty-state]');
		const clearButtons = catalog.querySelectorAll<HTMLButtonElement>('[data-clear-search], [data-empty-clear]');
		const rows = Array.from(catalog.querySelectorAll<HTMLElement>('[data-pack-row]'));
		const publishedRows = rows.filter((row) => row.dataset.kind === 'published').length;
		const briefRows = rows.length - publishedRows;

		const updateCatalog = () => {
			const query = search?.value.trim().toLocaleLowerCase() ?? '';
			const selectedStage = stage?.value ?? 'all';
			const mode = sort?.value ?? 'featured';
			const ordered = [...rows].sort((left, right) => {
				if (mode === 'name') return (left.dataset.name ?? '').localeCompare(right.dataset.name ?? '');
				if (mode === 'reviewed') return (right.dataset.reviewed ?? '').localeCompare(left.dataset.reviewed ?? '') || Number(left.dataset.order) - Number(right.dataset.order);
				return Number(left.dataset.order) - Number(right.dataset.order);
			});
			let visible = 0;
			for (const row of ordered) {
				const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
				const matchesStage = selectedStage === 'all' || row.dataset.kind === selectedStage;
				const match = matchesQuery && matchesStage;
				row.hidden = !match;
				if (match) visible += 1;
				list?.append(row);
			}
			if (count) count.textContent = query || selectedStage !== 'all' ? `${visible} of ${rows.length} entries` : `${publishedRows} published · ${briefRows} open briefs`;
			if (empty) empty.hidden = visible !== 0;
			for (const button of clearButtons) button.hidden = !query && button.hasAttribute('data-clear-search');
		};

		search?.addEventListener('input', updateCatalog);
		stage?.addEventListener('change', updateCatalog);
		sort?.addEventListener('change', updateCatalog);
		for (const button of clearButtons) button.addEventListener('click', () => {
			if (!search) return;
			search.value = '';
			updateCatalog();
			search.focus();
		});
		updateCatalog();
	}
</script>
